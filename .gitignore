# Dependencies
node_modules/

# Build output (the Tauri shell compiles into src-tauri/target; src-tauri/gen holds generated schemas)
dist/
src-tauri/target/
src-tauri/gen/

# Test and tool caches
coverage/
.vitest/
*.tsbuildinfo

# Local environment files
.env
.env.*
*.local

# Local data: the app keeps its database and its logs in its data folder, outside the repository;
# these patterns keep any copy of them out of git
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Operating system files
.DS_Store
Thumbs.db

# Local planning documents and agent workspaces (Claude Code "superpowers" plugin), never committed
docs/superpowers/
.superpowers/

# Local AI agent helping for the development
CLAUDE.md
