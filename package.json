{
  "name": "the-library",
  "version": "0.1.3",
  "description": "Desktop companion for Deadlock players who main Paige",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "canary": "vitest run --config vitest.canary.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "check:dev-code": "node scripts/check-dev-code.ts",
    "release:prepare": "node scripts/release/prepare-release.ts",
    "notices": "node scripts/release/third-party-notices.ts"
  },
  "dependencies": {
    "@fabianlars/tauri-plugin-oauth": "2.1.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/alegreya-sc": "5.3.0",
    "@hpcc-js/wasm-zstd": "1.17.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-http": "2.8.3",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-sql": "2.6.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "i18next": "26.7.2",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query-devtools": "5.106.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.2",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-jsdoc": "65.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "sql.js": "1.15.2",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
