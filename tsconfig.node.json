{
  // Type-checking of the tooling configuration files, which run in Node.js.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "incremental": true,
    "noEmit": true,
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    // `bundler` rather than `nodenext`: it types the default imports of the ESLint plugins correctly.
    "moduleResolution": "bundler",
    "types": ["node"],
    // eslint.config.js is plain JavaScript but is type-checked too.
    "allowJs": true,
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts", "eslint.config.js", "types"]
}
